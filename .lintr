linters: linters_with_defaults(line_length_linter = line_length_linter(120), object_name_linter = object_name_linter(styles = c("snake_case", "symbols", "dotted.case"), regexes = c("scientific-symbols" = "^[A-Z][A-Za-z0-9_]*$", "subscript-notation" = "^[a-z][a-z0-9]*_[A-Z][A-Za-z0-9_]*$")), object_length_linter = object_length_linter(40), object_usage_linter = NULL)
exclusions: list("inst/examples/section12-reproduction.Rmd", "inst/examples/formal-model-comparison.R", "vignettes/valence-foundry.Rmd", "vignettes/exploring-toy-models.Rmd", "tests/testthat/_problems/", "tests/scratch/", "inst/genealogy/", "inst/simulacra/")
